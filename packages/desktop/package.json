{
	"name": "@prime-desktop/app",
	"version": "0.10.1",
	"private": true,
	"description": "Local macOS desktop client for Prime Agent",
	"author": "Prime Desktop contributors",
	"license": "MIT",
	"type": "module",
	"main": "dist/main/index.cjs",
	"engines": {
		"node": ">=22.12.0",
		"npm": ">=11.10.0"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "node scripts/build.mjs",
		"check": "biome check . --error-on-warnings && tsc --noEmit",
		"test": "vitest run",
		"package": "node scripts/package.mjs",
		"release:artifacts": "node scripts/release-artifacts.mjs",
		"release:init": "node scripts/init-update-key.mjs",
		"test:smoke": "node scripts/smoke.mjs"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.0",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"node-pty": "1.1.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"yaml": "2.8.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@electron/packager": "20.3.0",
		"@resvg/resvg-js": "2.6.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.4.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"electron": "44.1.0",
		"esbuild": "0.28.2",
		"jsdom": "30.0.1",
		"playwright": "1.62.1",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
